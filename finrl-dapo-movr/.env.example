# Copy this to .env and fill in your values before running scripts
# NO PAID API KEYS REQUIRED — all LLM calls use Groq free tier

# Groq free-tier API key (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace token (free at https://huggingface.co/settings/tokens)
# Required for downloading datasets and gated models
HF_TOKEN=your_huggingface_token_here

# vLLM server config
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_PORT=8000
